#!/bin/bash
# pre-commit hook: run the full check pipeline via make.

# Only run if shell files are staged.
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACM -- '*.sh')
if [[ -z "${STAGED_SH}" ]]; then
  exit 0
fi

if ! make check; then
  echo ""
  echo "Commit blocked: fix the issues above."
  exit 1
fi
